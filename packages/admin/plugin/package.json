{
  "name": "@beaconsgg/admin-plugin",
  "version": "1.3.4",
  "description": "The operator console's plugin contract: what a game's operator screens are (GamePlugin) and what the console hands them (AdminHost). A game depends on this, never on the console.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/beacons-gg/beacon.admin.git",
    "directory": "packages/admin/plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "peerDependencies": {
    "@beaconsgg/client-sdk": "^1.0.0",
    "@beaconsgg/identity": "^1.0.0",
    "@beaconsgg/protocol-types": "^1.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@beaconsgg/client-sdk": "^1.0.0",
    "@beaconsgg/identity": "^1.0.0",
    "@beaconsgg/protocol-types": "^1.0.0",
    "@beaconsgg/tsconfig": "^1.0.0",
    "@beaconsgg/vitest-config": "^1.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "catalog:",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
