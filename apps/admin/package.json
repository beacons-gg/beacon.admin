{
  "name": "@beaconsgg/admin",
  "version": "0.0.0",
  "private": true,
  "description": "The Beacon operator console: a Next.js app that manages a list of Beacon servers from one pane of glass. A wallet in the browser signs every admin request with the published client packages, so the Next server never sees a key.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@beaconsgg/admin-plugin": "workspace:*",
    "@beaconsgg/client-sdk": "^1.1.0",
    "@beaconsgg/geo": "^1.1.0",
